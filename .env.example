# Supabase public client configuration (safe variable names only; add values locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side environment isolation. Preview/Development use "development" and
# their own project reference; Vercel Production uses "production" and the
# separately configured Production project reference. Never expose service role.
SUPABASE_ENVIRONMENT=development
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# Persistence remains mock unless explicitly selected.
NEXT_PUBLIC_DATA_REPOSITORY=mock
NEXT_PUBLIC_AUTH_PROVIDER=supabase
NEXT_PUBLIC_SITE_URL=https://9jafootballai.com.ng

# Server-side football ingestion controls. Live access remains disabled by default.
FOOTBALL_DATA_PROVIDER=disabled
FOOTBALL_DATA_PROVIDER_ENABLED=false
FOOTBALL_API_KEY=
FOOTBALL_API_DAILY_REQUEST_BUDGET=30
FOOTBALL_INGESTION_DRY_RUN=true

# Forward shadow evaluation remains inert unless explicitly enabled server-side.
SHADOW_PREDICTION_PIPELINE_ENABLED=false
SHADOW_PROVIDER_CALLS_ENABLED=false
SHADOW_MAX_PROVIDER_REQUESTS_PER_RUN=1
SHADOW_MAX_FIXTURE_REFRESH_AGE_MINUTES=180
SHADOW_PREDICTION_HORIZON_HOURS=168
PUBLIC_PREDICTION_PUBLISHING_ENABLED=false
FOOTBALL_RESULT_SETTLEMENT_ENABLED=false
FOOTBALL_MAX_PROVIDER_REQUESTS_PER_RUN=2
CRON_SECRET=

# Payment foundation remains inert until a separately approved activation batch.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
# "test" requires sk_test_... and a TEST plan; "live" requires sk_live_...
# plus the canonical https://9jafootballai.com.ng callback host.
PAYSTACK_ENVIRONMENT=test
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_API_BASE_URL=https://api.paystack.co
# Environment-specific Paystack PLN_... code. Production must use the genuine
# LIVE NGN 3,000/month plan code created in the Paystack LIVE dashboard.
PAYSTACK_CONSUMER_MONTHLY_PLAN_CODE=
PAYSTACK_SUBSCRIPTION_EMAIL_TOKEN=
PAYSTACK_INTEGRATION_TESTS=false
PAYSTACK_MANAGED_LAUNCH_PLAN_CODE=
PAYSTACK_MANAGED_BUSINESS_PLAN_CODE=
PAYMENT_RECONCILIATION_ENABLED=false
